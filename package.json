{
  "name": "arrow-expert",
  "version": "3.25.0",
  "androidVersionCode": 1,
  "private": true,
  "description": "Tap Away Arrows style puzzle game. Vanilla JS + Vite, packaged for Android with Capacitor.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:release": "vite build --mode release",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:timing",
    "test:unit": "vitest run --exclude tests/generator.test.js --exclude tests/shapeBoards.test.js --exclude tests/hitTest.test.js",
    "test:timing": "vitest run tests/generator.test.js tests/shapeBoards.test.js tests/hitTest.test.js --no-file-parallelism",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "shapes:sources": "npm --prefix scripts/shape-sources ci",
    "shapes:build": "node scripts/build-shapes.mjs",
    "shapes:sheet": "node scripts/shape-sheet.mjs",
    "assets": "python3 scripts/assets.py && prettier --write store-assets/README.md",
    "screenshots": "node scripts/store-screenshots.cjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/splash-screen": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
