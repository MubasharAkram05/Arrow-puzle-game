{
  "name": "arrow-escape",
  "version": "3.10.0",
  "private": true,
  "description": "Tap Away Arrows style puzzle game. Vanilla JS + Vite, packaged for Android with Capacitor.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "shapes:sources": "npm --prefix scripts/shape-sources ci",
    "shapes:build": "node scripts/build-shapes.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
